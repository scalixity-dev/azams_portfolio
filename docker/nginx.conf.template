# Same caching rules as public/_headers (used by the Netlify deploy).
map $uri $cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    ~^/reels/   "public, max-age=86400";
    ~\.svg$     "public, max-age=86400";
    default     "no-cache";
}

server {
    # Host network: loopback for the deploy health checks, docker0 for the
    # cloudflared tunnel. Not reachable from LAN/Tailscale.
    listen 127.0.0.1:${PORT};
    listen 172.17.0.1:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
